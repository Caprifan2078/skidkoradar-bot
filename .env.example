# Bot token from BotFather. KEEP PRIVATE. Never commit .env into GitHub.
TELEGRAM_BOT_TOKEN=PASTE_TOKEN_HERE
# REQUIRED for private use. Send /id to the bot to discover yours, then restart.
ALLOWED_USER_IDS=
DATABASE_PATH=./data/deals.sqlite3
MAX_STORES_PER_SCAN=40
REQUEST_PAUSE_SECONDS=1.5

# Existing third-party Pyaterochka MCP (separate process). Unverified with live retailer.
PYATEROCHKA_MCP_URL=

# Optional custom JSON source bridges. These are NOT official vendor endpoints.
# A blank value means that chain has NO live price/stock connection.
PEREKRESTOK_SOURCE_URL=
PEREKRESTOK_SOURCE_TOKEN=
MAGNIT_SOURCE_URL=
MAGNIT_SOURCE_TOKEN=
MAGNIT_COSMETIC_SOURCE_URL=
MAGNIT_COSMETIC_SOURCE_TOKEN=
CHIZHIK_SOURCE_URL=
DIXY_SOURCE_URL=
LENTA_SOURCE_URL=
VKUSVILL_SOURCE_URL=
AUCHAN_SOURCE_URL=
# PYATEROCHKA_SOURCE_URL=  # optional JSON bridge instead of MCP

# Public channel deal scanning every 30 minutes, server running required.
# May be 300..7200 seconds. No Telegram login or personal user session needed.
DISCOVERY_INTERVAL_SECONDS=1800

# v0.6 independent retailer price hunter, run only when bot is online.
# Up to 2 logical catalog pages per store per cycle; underlying MCP category
# browsing needs up to 2 MCP calls per page. Progress persists in SQLite.
# If no catalog browsing, uses words from /track or built-in defaults.
HUNT_INTERVAL_SECONDS=3600
HUNT_STORES_PER_CYCLE=3
HUNT_MAX_REQUESTS=12

# v0.7 store-specific price alerts for explicitly tracked items.
WATCH_INTERVAL_SECONDS=1800
WATCH_MAX_REQUESTS=12
